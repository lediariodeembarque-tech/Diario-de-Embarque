{
  "name": "diario-de-embarque",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:versions": "npm run build && wrangler versions upload --config wrangler.jsonc",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name diario-de-embarque",
    "db:migrate:local": "wrangler d1 migrations apply diario-de-embarque --local",
    "db:migrate:remote": "wrangler d1 migrations apply diario-de-embarque --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "6.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250917.0",
    "typescript": "5.8.2",
    "wrangler": "4.135.0"
  }
}
