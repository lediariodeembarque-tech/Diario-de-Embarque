{
  "name": "diario-de-embarque",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:versions": "npm run build && wrangler versions upload",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name diario-de-embarque",
    "db:migrate:local": "wrangler d1 migrations apply diario-de-embarque --local",
    "db:migrate:remote": "wrangler d1 migrations apply diario-de-embarque --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250917.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.134.0"
  }
}
